# Copy to .env.local and fill in. The app shares the dispatcher app's MongoDB and staff_users.
MONGODB_URI=
MONGODB_DB=

# Signs the session cookie (required in production). Generate: openssl rand -hex 32
OUTLOOK_COOKIE_SECRET=

# Optional: SMTP for the cancellation e-mails sent by the copied booking APIs
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Optional: public URL of the partner portal (used in traveler tracking links)
PARTNER_PORTAL_URL=

# Optional break-glass account (both required to enable). Prefer real staff_users accounts.
# DISPATCHER_EMAIL=
# DISPATCHER_PASSWORD=
